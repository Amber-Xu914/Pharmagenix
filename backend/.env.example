# ---- Flask ----
SECRET_KEY=change-me
ADMIN_TOKEN=change-me-admin-token
CORS_ORIGINS=*

# ---- MySQL ----
DATABASE_URL=mysql+pymysql://dgi:dgi_password@localhost:3306/dgi_explorer?charset=utf8mb4

# ---- LLMs ----
# Primary model (OpenAI). Confirm the exact model ID for "GPT-6 Luna" in your OpenAI dashboard.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Comparison model (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
LLM_MAX_TOKENS=4000
LLM_TIMEOUT=90
# Leave empty to use each model's default temperature (some reasoning models reject it)
LLM_TEMPERATURE=

# ---- Biomedical APIs ----
DGIDB_URL=https://dgidb.org/api/graphql
PUBTATOR_URL=https://www.ncbi.nlm.nih.gov/research/pubtator3-api
# PharmGKB has been rebranded to ClinPGx; api.pharmgkb.org no longer responds.
PHARMGKB_URL=https://api.clinpgx.org/v1
# DrugBank requires a licensed API key; the source is skipped when empty.
DRUGBANK_URL=https://api.drugbank.com/v1
DRUGBANK_API_KEY=
# Gene profile (public, no key needed)
# UNIPROT_URL=https://rest.uniprot.org

# Patient VCF workflow. VEP is public. OncoKB is optional: with a token (free for academic use,
# https://www.oncokb.org/account/register) its levels are added next to CIViC's.
# VEP_URL=https://rest.ensembl.org
# VEP_GRCH37_URL=https://grch37.rest.ensembl.org
ONCOKB_API_TOKEN=
# Literature retrieval for the Literature agent: auto (MedCPT if requirements-rag.txt is installed) | medcpt | keyword
# VCF_LITERATURE_RANKER=auto

# ---- Local store of live API answers (app/http_cache.py) ----
# fallback: live first, stored answer when an API fails | offline: stored answer first (demo) | off
# Fill it before a demo with: flask --app run warm-cache
# HTTP_CACHE=fallback

# ---- Local reference datasets (flask --app run import-data) ----
# Defaults point at the official sources; override only if you mirror them.
# HGNC_URL=https://storage.googleapis.com/public-download-files/hgnc/tsv/tsv/hgnc_complete_set.txt
# CHEMBL_API_URL=https://www.ebi.ac.uk/chembl/api/data
# CPIC_API_URL=https://api.cpicpgx.org/v1
# CLINPGX_DOWNLOAD_URL=https://api.clinpgx.org/v1/download/file/data
# DGIDB_DOWNLOAD_URL=https://dgidb.org/data/latest
# FDA_BIOMARKERS_URL=https://www.fda.gov/drugs/science-and-research-drugs/table-pharmacogenomic-biomarkers-drug-labeling
# ONCOTREE_API_URL=https://oncotree.info/api
# INTOGEN_DRIVERS_URL=https://www.intogen.org/download?file=IntOGen-Drivers-20240920.zip
# CIVIC_EVIDENCE_URL=https://civicdb.org/downloads/nightly/nightly-ClinicalEvidenceSummaries.tsv
# CANCER_HOTSPOTS_URL=https://www.cancerhotspots.org/api/hotspots/single
# CBIOPORTAL_URL=https://www.cbioportal.org/api
# PBS_API_URL=https://data-api.health.gov.au/pbs/api/v3
# The default is the published key for unregistered users (1 request / 20 s, shared). Register for your own at
# https://data-api-portal.health.gov.au
# PBS_SUBSCRIPTION_KEY=

# ---- MLflow (optional) ----
# Track every search as an MLflow run + trace. View with: .venv/bin/flask --app run mlflow-ui (http://127.0.0.1:5050)
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# MLFLOW_EXPERIMENT_PREFIX=pharmagenix
# MLFLOW_LOG_ARTIFACTS=true
# List the evaluation checks (flask --app run mlflow-eval) under Judges. MLflow stores code-based checks only with
# this flag, as a stored check is code it runs later: set it only for a tracking store you trust (e.g. local mlflow.db).
# MLFLOW_SERVER_ENABLE_CUSTOM_SCORERS=true
